extends ../layout

block content 
    h1 Orders 
    section(class="order")
        if order
            h2(class="order-title") My Basket
            h3(class="order-id")=order.order_id
            - var cost=0
            each product in order.products 
                include ../product/productCardOrder.pug
                - cost+=product.price
            p(class="total-price")=`Precio total: ${cost}€`
        else 
            p There is no product available