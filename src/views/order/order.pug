extends ../layout

block content 
    h1 Orders 
    section(class="order")
        if order
            article 
            h2(class="order-title") My Basket
            h3(class="order-id")=order.order_id
            each product in order.products 
                include ../product/productCard.pug
                button Remove from basket
        else 
            p There is no product available