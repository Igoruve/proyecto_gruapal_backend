article 
    div(class="product-img")
        img(src=`/assets/${product.name.toLowerCase()}.jpg`, alt="product-img")
    h2(class="product-name")=product.name
    p(class="product-price")=product.price+"€"
    p(class="product-description")=product.description 
    form(action=`/orders/${product.product_id}`, method="post") 
        button(class="basket-button") Eliminar de la cesta